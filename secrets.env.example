# secrets.env.example — the committed CONTRACT for local configuration (REPO-BASELINE §2).
# Copy to .env (gitignored) only if you run the pieces by hand; the Aspire AppHost reads secrets from
# `dotnet user-secrets` (scripts/setup.sh) and needs no .env at all.
#
# Every variable has a TIER and says what DEGRADES without it (P8). Values here are empty or obvious
# placeholders; a real value in this file is a finding.
#
#   always  — required for the piece to start
#   mode    — selects a mode; a default exists
#   secret  — a credential: platform secret in production, user-secrets locally, NEVER in the repo
#   ci      — only the CI/deploy pipeline needs it
#   tuning  — optional knob with a safe default
#
# Config keys map to environment variables with `__` for `:` (Jwt:Authority -> Jwt__Authority).

# ── API (src/WorkInPoland.Api) ───────────────────────────────────────────────────────────────
# mode    Postgres connection string. Absent -> InMemory database: works, but data is lost on restart.
ConnectionStrings__apidb=
# mode    PostgreSQL (default when a connection string exists). SqlServer is NOT supported (ADR 0011).
DATABASE_PROVIDER=
# always  Public origin of authservice (JWKS source). Absent -> every authenticated endpoint answers
#         401 and /health reports auth=not-configured; public reads still work.
Jwt__Authority=
Jwt__Issuer=WorkInPoland
Jwt__Audience=WorkInPoland
# tuning  false only on a private network (compose/e2e); never in production.
Jwt__RequireHttpsMetadata=
# mode    Canonical URI of the OAuth MCP route (https://<api host>/mcp/account). Absent -> /mcp/account and
#         its metadata are not mapped; the anonymous /mcp endpoint still works.
Mcp__ResourceUri=
# mode    authservice's Jwt:PublicBaseUrl (issuer of MCP tokens). Required with Mcp__ResourceUri.
Mcp__AuthorizationServer=
# tuning  Web origin(s), if a browser ever calls the API directly. The BFF is same-origin, so usually unset.
Cors__AllowedOrigins__0=
# tuning  Behind a proxy that sets the client address (Fly: Fly-Client-IP). Trusted ONLY when the second key is true.
Network__ClientIpHeader=
Network__TrustProxyClientIpHeader=
# tuning  Listing lifetime in days / simultaneously published listings per company.
Jobs__ListingLifetimeDays=30
Jobs__MaxPublishedPerCompany=25
# tuning  Per-client permits per minute (api / public / global) and the process-wide concurrency bound.
RateLimiting__ApiPermitsPerMinute=240
RateLimiting__PublicPermitsPerMinute=120
RateLimiting__GlobalPermitsPerMinute=600
RateLimiting__MaxConcurrentRequests=200
# tuning  true -> insert ~14 fictional Polish demo listings (insert-if-missing by slug). Never in production.
Seed__Demo=
# tuning  Any OTLP collector. Absent -> no export; health probes are filtered out of traces regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Web (web/app) — read at request time, never baked into the bundle ─────────────────────────
# always  Where the BFF reaches the API / authservice from the SERVER side.
API_BASE_URL=
AUTH_BASE_URL=
# always  Browser-facing authservice origin (social-login redirect). Defaults to AUTH_BASE_URL.
AUTH_PUBLIC_URL=
# always  Must equal authservice's Jwt:Issuer / Jwt:Audience (middleware verifies signature + both).
AUTH_ISSUER=WorkInPoland
AUTH_AUDIENCE=WorkInPoland
# always  Public addresses shown to users (MCP page, canonical URLs, sitemap).
PUBLIC_API_URL=
PUBLIC_SITE_URL=
# mode    Must equal authservice's ConsentVersions. A mismatch makes registration fail with a version error.
CONSENT_TERMS_VERSION=2026-10-05
CONSENT_PRIVACY_VERSION=2026-10-05
# tuning  auto (default): `secure` cookie unless NODE_ENV=development. false only for plain-http local stacks.
SESSION_COOKIE_SECURE=

# ── authservice (run from its published image; configured by AppHost / flyio/authservice.fly.toml) ──
# secret  The system's ONLY signing key, PKCS#8 PEM. Local: generated by scripts/setup.sh into user-secrets.
#         Where Jwt__Algorithm is NOT pinned to RS256, a missing key makes authservice infer the symmetric
#         algorithm and publish an EMPTY JWKS, so every consumer rejects every token while looking healthy.
#         flyio/authservice.fly.toml pins RS256 (a missing key then fails the start loudly) and the deploy
#         additionally asserts a non-empty key set.
Jwt__PrivateKeyPem=
# secret  Optional. Without it authservice only LOGS emails (verification, reset). Sign-up still works.
SendGrid__ApiKey=
SendGrid__FromEmail=
# secret  Optional. Without them the Google/GitHub buttons are not rendered.
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__GitHub__ClientId=
OAuth__GitHub__ClientSecret=
# secret  Optional. Seeds one SuperAdmin on first start; without it there is no admin account.
InitialAdmin__Email=
InitialAdmin__Password=
# secret  Required once an MCP client is configured (production): AuthorizationServer__EncryptionKey (base64, 32 bytes)
#         and AuthorizationServer__Clients__0__ClientSecret (hex, 32 bytes). See flyio/SECRETS.md.

# ── Scripts (scripts/dev-stack.sh) ───────────────────────────────────────────────────────────
# tuning  Image to run for authservice. Default ghcr.io/konradcinkusz/authservice:v0.3.4
AUTHSERVICE_IMAGE=
# tuning  Checkout of konradcinkusz/authservice, used ONLY when the image cannot be pulled (read-only).
AUTHSERVICE_SOURCE=
# tuning  Seconds to wait for the stack to answer, default 240.
WAIT_SECONDS=

# ── CI / deploy only (GitHub environment `production`; see flyio/SECRETS.md) ─────────────────
# ci      FLY_API_TOKEN, PG_ADMIN_PASSWORD, APIDB_PASSWORD, AUTHDB_PASSWORD, JWT_PRIVATE_KEY_PEM,
#         AUTH_ENCRYPTION_KEY, MCP_CLIENT_SECRET (+ optional INITIAL_ADMIN_*, SENDGRID_*). Never set locally.
