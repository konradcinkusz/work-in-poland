# Runtime configuration of the web BFF. Every value is read at REQUEST time (never baked into
# the image), so one image serves every environment. Copy to .env.local for local development.

# --- Backend addresses (server side only; the browser never sees these) -------------------
# Internal/explicit address of the Work in Poland API. First rung of the candidate ladder:
#   API_BASE_URL -> services__api__https__0 -> services__api__http__0 (Aspire) ->
#   http://api:8080 (internal DNS) -> http://localhost:8080
API_BASE_URL=http://localhost:8080

# Origin of authservice, used by the server side only (login, refresh, JWKS, ...).
AUTH_BASE_URL=http://localhost:8081
# Origin of authservice as seen by the BROWSER, used only for the social-login redirect.
# Defaults to AUTH_BASE_URL when unset.
AUTH_PUBLIC_URL=

# Expected issuer and audience of the access token (must equal the API's Jwt:Issuer/Audience).
AUTH_ISSUER=WorkInPoland
AUTH_AUDIENCE=WorkInPoland

# --- Public addresses (served to the browser through GET /api/config) ---------------------
# Public origin of the API (used on /mcp to print the MCP endpoint URLs).
PUBLIC_API_URL=http://localhost:8080
# Public origin of this site (canonical URLs, sitemap, JSON-LD, OAuth returnUrl).
PUBLIC_SITE_URL=http://localhost:3000

# --- Legal document versions (must match authservice ConsentVersions) ---------------------
CONSENT_TERMS_VERSION=2026-10-05
CONSENT_PRIVACY_VERSION=2026-10-05

# --- Cookies -------------------------------------------------------------------------------
# auto (default): Secure unless NODE_ENV=development. true / false force it. Use false only
# when serving plain http on a non-localhost host (e.g. a docker-compose service name).
SESSION_COOKIE_SECURE=auto
